# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional OpenAI API key for direct GPT-4o / GPT-4o-mini inference.
OPENAI_API_KEY=""

# ANTHROPIC_API_KEY: Optional Anthropic API key for direct Claude 3.5 Sonnet / Haiku inference.
ANTHROPIC_API_KEY=""

# DEEPSEEK_API_KEY: Optional DeepSeek API key for direct DeepSeek-V3 / DeepSeek-R1 inference.
DEEPSEEK_API_KEY=""

# GROQ_API_KEY: Optional Groq Cloud API key for ultra-fast LPU inference (Llama 3.3, Mixtral, DeepSeek R1).
GROQ_API_KEY=""

# QWEN_API_KEY / DASHSCOPE_API_KEY: Optional Alibaba Cloud DashScope API Key for direct Qwen 2.5 / Qwen Coder inference.
QWEN_API_KEY=""
DASHSCOPE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
